# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# self-hosted embedding model (downloaded by scripts/fetch-model.mjs at
# prebuild time; 118MB exceeds GitHub's file limit so it is not committed)
/public/models/
# onnxruntime-web wasm runtime (copied from node_modules at postinstall)
/public/wasm/
# prebundled embedding worker (scripts/build-worker.mjs at predev/prebuild)
/public/embed.worker.js
# eval script's transpile cache
/eval/.tmp/

# typescript
*.tsbuildinfo
next-env.d.ts
